{
  "name": "andrew-cohen-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:nondualizer-css && next dev",
    "build": "npm run build:nondualizer-css && next build",
    "build:nondualizer-css": "npm run build:css -w @andrew-cohen/nondualizer",
    "start": "next start",
    "lint": "eslint",
    "sync:youtube": "python3 scripts/sync-youtube-archive.py",
    "sync:transcripts": "python3 scripts/sync-youtube-transcripts.py",
    "sync:journal": "python3 scripts/sync-journal.py",
    "sync:listen": "python3 scripts/sync-listen.py",
    "sync:site-videos": "python3 scripts/sync-site-videos.py",
    "extract:book:secret": "python3 scripts/extract-enlightenment-is-a-secret.py",
    "extract:books": "python3 scripts/extract-books.py",
    "i18n:seed": "python3 scripts/generate-home-translations.py"
  },
  "dependencies": {
    "@andrew-cohen/nondualizer": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
