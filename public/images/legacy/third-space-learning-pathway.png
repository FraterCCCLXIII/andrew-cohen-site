<style id="wp-custom-css">
.post-content-template .elementor-widget-container p:first-child:first-letter {
	font-size: 145px;
	float: left;
	line-height: 80px;
	color: #ECA03D;
	padding-right:5px;
	margin-bottom:8px;
	display:inline-block !important;
}
.elementor-menu-anchor{
    display: block;
    position: relative;
    top: -200px;
    visibility: hidden;
}

.logged-in-as{
		display:none !important;
}
.cus-hov-box-2:hover .elementor-icon-box-icon .elementor-icon{
	background-color: #C0313B !important;
}

.elementor-post-navigation__next {
	margin-left: 20px;
}
.elementor-post-navigation__prev {
	margin-right: 20px;
}

.um .um-button.um-alt, .um input[type=submit].um-button.um-alt {
    color: #fff;
}
.um.um-password .um-field-block{
	color: #fff;
	font-family: "Poppins", Sans-serif;
	font-size: 16px;
}
.um.um-password .um-center .um-button{
	min-width: unset !important;
}

.elementor-post-navigation span.elementor-post-navigation__link__next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
	width: 100%;
}


.elementor-post-navigation span.elementor-post-navigation__link__prev {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
	width: 100%;
}


.authorbox .elementor-author-box__name::before {
	content: "Author:";
	position: absolute;
	top: 0px;
	font-size: 15px;
	color: grey;
}


body::-webkit-scrollbar {
     width: 12px;
}
 body::-webkit-scrollbar-track {
     background-color: #ffffff;
}
 body::-webkit-scrollbar-thumb {
     background-color: #C0313B;
     z-index: 5;
}
.footer-links a{
    color: #ffffff;
}
.footer-links a:hover{
    color: #ECA03D;
}
.multi-bg:before{
	mix-blend-mode: multiply!important;
}
.swiper-pagination .swiper-pagination-bullet{
	background: #ECA03D;
	opacity: 1;
}
.swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active{
	background: #C0313B;
	opacity: 1;
}
.feature-loop a{
    color: #C0313B;
}
.feature-loop a:hover{
    color: #ECA03D;
}

.avatar {
 
  transform: translatey(0px);
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0% {
    
    transform: translatey(0px);
  }
  50% {
   
    transform: translatey(-15px);
  }
  100% {
   
    transform: translatey(0px);
  }
}

.footy::after {
	content: '';
	background-image: url('https://3rd-space.org/wp-content/uploads/2024/04/shape.svg');
	position: absolute;
	width: 100%;
	height: 105px;
	top: -80px;
	left: 0px;
	background-repeat: no-repeat;
	background-size: cover;
	background-position: top;
}

@media only screen and (max-width: 1920px) {
  .footy::after {
	top: -100px;
	left: 0px;
}
}

@media only screen and (max-width: 1024px) {
  .footy::after {
	top: -40px;
	left: 0px;
}
}

@media only screen and (max-width: 600px) {
  .footy::after {
	top: -40px;
	left: 0px;
	height: 40px;
}
}

figcaption{
    color: #555 !important;
    font-size: 13px !important;
