}

.elementor-author-box__name{
	display:none !important;
}
.forum {
	padding-bottom:30px !important;
}

.forum td{
	background:transparent !important;
	border:0px !important;

}
.forum{
		border-bottom:3px solid #eb9f3d;
}
.forum tr{
	
}
.forum h5{
font-size:45px !important;
	line-height:45px !important;
	margin-bottom:6px;
	margin-top:0px;
	color:#eb9f3d;
	font-family: "Caveat", Sans-serif;
}
.forum p{
	font-size:16px;
	line-height:24px;
}

.comment td{
	color:#fff;
	background:transparent !important;
	border:0px;
}

.comment p{
	font-size:16px;
	line-height:24px;
}

.forum img.logo2{
	width:40px;
	height:40px;
	border-radius:50%;
	background:#c1313b;
	padding:0px;
	margin-top:-12px;
}
.avatar-image{
	width:40px;
	height:40px;
	border-radius:50% !important;
	background:#000;
	padding:0px;
	vertical-align:middle;

}


.youtube-container {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  overflow: hidden;
	margin-bottom:30px;
}

.youtube-container iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

